  "special_actions": {
    "_source": "engine/player/player.cpp:11350",
    "description": "Built-in pseudo-actions available in all APLs",
    "actions": {
      "variable": {
        "description": "Set, modify, or query a user-defined variable",
        "options": {
          "name":       { "required": true,  "description": "Variable name" },
          "op":         { "required": false, "default": "set", "description": "Operation to perform" },
          "value":      { "required": false, "description": "Expression for the value" },
          "value_else": { "required": false, "description": "Else-value for setif operation" },
          "condition":  { "required": false, "description": "Condition expression for setif operation" },
          "default":    { "required": false, "description": "Default/initial value" },
          "delay":      { "required": false, "description": "Delay before variable update" }
        },
        "operations": {
          "set":    { "description": "Set variable to value" },
          "add":    { "description": "Add value to variable" },
          "sub":    { "description": "Subtract value from variable" },
          "mul":    { "description": "Multiply variable by value" },
          "div":    { "description": "Divide variable by value" },
          "pow":    { "description": "Raise variable to power of value" },
          "mod":    { "description": "Variable modulo value" },
          "min":    { "description": "Assign minimum of variable and value" },
          "max":    { "description": "Assign maximum of variable and value" },
          "floor":  { "description": "Floor the variable value" },
          "ceil":   { "description": "Ceil the variable value" },
          "setif":  { "description": "Set variable to value if condition is true, else value_else" },
          "reset":  { "description": "Reset variable to default value" },
          "print":  { "description": "(Debug) Print variable to stdout" },
          "report": { "description": "Report value changes in HTML output" }
        }
      },
      "call_action_list": {
        "description": "Call another action list (returns to caller when list is exhausted)",
        "options": {
          "name":   { "required": true, "description": "Name of the action list to call" },
          "random": { "required": false, "description": "Randomize action order (int toggle)" }
        }
      },
      "run_action_list": {
        "description": "Run another action list (does not return to caller)",
        "options": {
          "name":   { "required": true, "description": "Name of the action list to run" },
          "random": { "required": false, "description": "Randomize action order (int toggle)" }
        }
      },
      "swap_action_list": {
        "description": "Alias for run_action_list"
      },
      "use_item": {
        "description": "Use an equipped item's on-use effect",
        "options": {
          "name":   { "required": false, "description": "Item name" },
          "slot":   { "required": false, "description": "Equipment slot (e.g., trinket1, trinket2)" },
          "effect_name": { "required": false, "description": "Special effect name to match" }
        }
      },
      "use_items": {
        "description": "Automatically use all usable items with on-use effects",
        "options": {
          "slots":           { "required": false, "description": "Pipe or colon-separated list of slot names (e.g., trinket1:trinket2)" },
          "check_existing":  { "required": false, "default": true, "description": "Ignore slot if matching use_item already exists" }
        }
      },
      "wait": {
        "description": "Wait for a specified duration",
        "options": {
          "sec": { "required": false, "default": "1.0", "description": "Seconds to wait (can be an expression)" }
        }
      },
      "pool_resource": {
        "description": "Pool resources instead of using abilities",
        "options": {
          "for_next":      { "required": false, "description": "Pool for the next action in the list" },
          "extra_amount":  { "required": false, "description": "Extra amount to pool beyond cost" },
          "wait":          { "required": false, "description": "Override wait time" },
          "force_wait":    { "required": false, "default": false, "description": "Force waiting (requires for_next=1)" },
          "resource":      { "required": false, "description": "Resource type to pool (e.g., energy, focus)" }
        }
      },
      "snapshot_stats": {
        "description": "Snapshot player stats (typically used in precombat)"
      },
      "cancel_buff": {
        "description": "Cancel an active buff",
        "options": {
          "name": { "required": true, "description": "Buff name to cancel" }
        }
      },
      "sequence": {
        "description": "Execute a fixed sequence of actions in order (sub-actions separated by colons)",
        "options": {
          "name": { "required": false, "description": "Sequence name" }
        }
      },
      "strict_sequence": {
        "description": "Execute a strict sequence of actions",
        "options": {
          "name":       { "required": false, "description": "Sequence name" },
          "allow_skip": { "required": false, "default": false, "description": "Allow skipping actions that aren't ready" }
        }
      },
      "restart_sequence": {
        "description": "Restart a named sequence from the beginning",
        "options": {
          "name": { "required": true, "description": "Sequence name to restart" }
        }
      },
      "cancel_action": {
        "description": "Cancel the current action"
      },
      "dismiss_pet": {
        "description": "Dismiss an active pet",
        "options": {
          "name": { "required": false, "description": "Pet name to dismiss" }
        }
      },
      "invoke_external_buff": {
        "description": "Invoke an external buff on the player",
        "options": {
          "name":     { "required": true, "description": "Buff name" },
          "duration": { "required": false, "description": "Buff duration" },
          "stacks":   { "required": false, "description": "Number of buff stacks" },
          "use_pool": { "required": false, "default": true, "description": "Whether to use pool" }
        }
      },
      "wait_until_ready": {
        "description": "Wait until the player is ready to act",
        "options": {
          "sec": { "required": false, "default": "1.0", "description": "Seconds to wait (can be an expression)" }
        }
      },
      "wait_for_cooldown": {
        "description": "Wait for a specific cooldown to be ready",
        "options": {
          "name": { "required": true, "description": "Action/cooldown name to wait for" }
        }
      },
      "cycling_variable": {
        "description": "Set a variable while cycling through targets (inherits variable options)",
        "options": {
          "name":       { "required": true, "description": "Variable name" },
          "op":         { "required": false, "default": "set", "description": "Operation to perform" },
          "value":      { "required": false, "description": "Expression for the value" },
          "value_else": { "required": false, "description": "Else-value for setif operation" },
          "condition":  { "required": false, "description": "Condition expression for setif operation" },
          "default":    { "required": false, "description": "Default/initial value" },
          "delay":      { "required": false, "description": "Delay before variable update" }
        }
      },
      "retarget_auto_attack": {
        "description": "Retarget auto attacks to the current target"
      },
      "start_moving": {
        "description": "Begin player movement"
      },
      "stop_moving": {
        "description": "Stop player movement"
      },
      "restore_mana": {
        "description": "Restore mana to the player",
        "options": {
          "mana": { "required": false, "default": 0, "description": "Amount of mana to restore" }
        }
      }
    }
  },

  "action_options": {
    "_source": "engine/action/action.cpp:542",
    "description": "Options available on every action line in the APL",
    "expression_options": {
      "if":                               { "type": "expression", "description": "Condition expression; action only executes if true" },
      "target_if":                        { "type": "expression", "description": "Target selection expression with optional mode prefix (min:/max:/first:)" },
      "interrupt_if":                     { "type": "expression", "description": "Condition to interrupt current channel" },
