        "in_flight_to_target":  { "type": "boolean", "description": "Whether a projectile is in flight to current target" },
        "in_flight_to_target_count": { "type": "number", "description": "Number of projectiles in flight to current target" },
        "in_flight_remains":    { "type": "number",  "description": "Time until nearest projectile lands" },
        "charges":              { "type": "number",  "description": "Available charges (delegates to cooldown)" },
