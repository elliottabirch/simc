{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SimulationCraft APL Expression Schema",
  "description": "Static schema of all APL expressions, operators, actions, and options extracted from the SimC C++ source. Dynamic names (buff names, spell names, etc.) are data-driven and marked with <name> placeholders.",
  "version": "1.0.0",
  "source_files": {
    "expressions":        "engine/sim/expressions.hpp",
    "sim_expressions":    "engine/sim/sim.cpp:3457",
    "player_expressions": "engine/player/player.cpp:11983",
    "action_expressions": "engine/action/action.cpp:3187",
    "buff_expressions":   "engine/buff/buff.cpp:334",
    "cooldown_expressions": "engine/sim/cooldown.cpp:520",
    "dot_expressions":    "engine/action/dot.cpp:408",
    "resource_expressions": "engine/player/player.cpp:12734",
    "variable_operations": "engine/action/variable.hpp:22"
  },

  "operators": {
    "unary": {
      "+":       { "token": "TOK_PLUS",  "description": "Unary plus" },
      "-":       { "token": "TOK_MINUS", "description": "Unary minus (negation)" },
      "!":       { "token": "TOK_NOT",   "description": "Logical NOT" },
      "@":       { "token": "TOK_ABS",   "description": "Absolute value" },
      "floor()": { "token": "TOK_FLOOR", "description": "Floor (round down)" },
      "ceil()":  { "token": "TOK_CEIL",  "description": "Ceiling (round up)" }
    },
    "binary": {
      "+":  { "token": "TOK_ADD",   "description": "Addition" },
      "-":  { "token": "TOK_SUB",   "description": "Subtraction" },
      "*":  { "token": "TOK_MULT",  "description": "Multiplication" },
      "%":  { "token": "TOK_DIV",   "description": "Division (NOTE: not modulus!)" },
      "%%": { "token": "TOK_MOD",   "description": "Modulus" },
      "&&": { "token": "TOK_AND",   "description": "Logical AND" },
      "||": { "token": "TOK_OR",    "description": "Logical OR" },
      "^":  { "token": "TOK_XOR",   "description": "Logical XOR (also ^^)" },
      "==": { "token": "TOK_EQ",    "description": "Equal" },
      "!=": { "token": "TOK_NOTEQ", "description": "Not equal" },
      "<":  { "token": "TOK_LT",    "description": "Less than" },
      "<=": { "token": "TOK_LTEQ",  "description": "Less than or equal" },
      ">":  { "token": "TOK_GT",    "description": "Greater than" },
      ">=": { "token": "TOK_GTEQ",  "description": "Greater than or equal" },
      "~":  { "token": "TOK_IN",    "description": "In set" },
      "!~": { "token": "TOK_NOTIN", "description": "Not in set" },
      "<?": { "token": "TOK_MIN",   "description": "Minimum of two values" },
      ">?": { "token": "TOK_MAX",   "description": "Maximum of two values" }
    },
    "grouping": {
      "(": { "token": "TOK_LPAR", "description": "Left parenthesis" },
      ")": { "token": "TOK_RPAR", "description": "Right parenthesis" }
    }
  },

  "expressions": {
    "sim_level": {
      "_source": "engine/sim/sim.cpp:3457",
      "keywords": {
        "time":                           { "type": "number", "description": "Current simulation time in seconds" },
        "fight_remains":                  { "type": "number", "description": "Expected remaining fight time in seconds" },
        "interpolated_fight_remains":     { "type": "number", "description": "Interpolated remaining fight time" },
        "expected_combat_length":         { "type": "number", "description": "Expected total iteration time" },
        "desired_targets":                { "type": "number", "description": "Configured desired target count" },
        "desired_tank_targets":           { "type": "number", "description": "Configured desired tank target count" },
        "initial_targets":                { "type": "number", "description": "Number of initial targets in the sim" },
        "enemies":                        { "type": "number", "description": "Total number of enemy targets" },
        "active_enemies":                 { "type": "number", "description": "Currently active (non-sleeping) enemies" },
        "active_allies":                  { "type": "number", "description": "Currently active allies" },
        "active_allied_augmentations":    { "type": "number", "description": "Number of active Augmentation Evokers" },
        "channel_lag":                    { "type": "number", "description": "Mean channel lag" },
        "channel_lag_stddev":             { "type": "number", "description": "Channel lag standard deviation" },
        "nonexecute_actors_pct":          { "type": "number", "description": "Percentage of actors without execute abilities" },
        "target":                         { "type": "number", "description": "Primary sim target actor index" }
      },
      "prefixes": {
        "fight_style.<style_name>":       { "type": "boolean", "description": "Check if current fight style matches" },
        "aura.<name>.<suffix>":           { "type": "varies", "description": "Sim-wide aura/buff expression (uses buff suffixes)" },
        "actors.<name>.<expression>":     { "type": "varies", "description": "Access another actor's expressions" },
        "raid_event.<type>.<filter>":     { "type": "number", "description": "Query upcoming raid events" }
      }
    },

    "raid_event_filters": {
      "_source": "engine/sim/raid_event.cpp:2367",
      "description": "Filters available for raid_event.<type>.<filter> expressions",
      "filters": {
        "in":           { "type": "number", "description": "Time until next event of this type" },
        "cooldown":     { "type": "number", "description": "Cooldown of event" },
        "exists":       { "type": "boolean", "description": "Whether this event type exists" },
        "remains":      { "type": "number", "description": "Remaining duration of active event" },
        "up":           { "type": "boolean", "description": "Whether event is currently active" },
        "duration":     { "type": "number", "description": "Duration of the event" },
        "distance":     { "type": "number", "description": "Distance of the event" },
        "distance_min": { "type": "number", "description": "Minimum distance" },
        "distance_max": { "type": "number", "description": "Maximum distance" },
        "amount":       { "type": "number", "description": "Amount/count of event" },
        "to_pct":       { "type": "number", "description": "Target percentage of event" },
        "count":        { "type": "number", "description": "Number of event occurrences" },
        "has_boss":     { "type": "boolean", "description": "Whether event has a boss" }
      }
    },

    "player_level": {
      "_source": "engine/player/player.cpp:11983",
      "keywords": {
        "level":                { "type": "number", "description": "Player true level" },
        "name":                 { "type": "number", "description": "Player actor index" },
        "self":                 { "type": "number", "description": "Player actor index" },
        "target":               { "type": "number", "description": "Current target actor index" },
        "in_combat":            { "type": "boolean", "description": "Whether player is in combat" },
        "in_boss_encounter":    { "type": "boolean", "description": "Whether in a boss encounter" },
