    },
    "boolean_options": {
      "interrupt":                        { "type": "boolean",    "description": "Allow interrupting channels for this action" },
      "interrupt_global":                 { "type": "boolean",    "description": "Allow global interrupt" },
      "interrupt_immediate":              { "type": "boolean",    "description": "Interrupt immediately rather than waiting for tick" },
      "chain":                            { "type": "boolean",    "description": "Chain channel casts" },
      "cycle_targets":                    { "type": "boolean",    "description": "Cycle through all available targets" },
      "cycle_players":                    { "type": "boolean",    "description": "Cycle through all players" },
      "moving":                           { "type": "boolean",    "description": "Only use while moving (1) or stationary (0)" },
      "wait_on_ready":                    { "type": "boolean",    "description": "Wait for action to become ready instead of skipping" },
      "use_off_gcd":                      { "type": "boolean",    "description": "Allow use during GCD" },
