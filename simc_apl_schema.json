      "sync":                             { "type": "string",     "description": "Sync with another action's cooldown" },
      "max_cycle_targets":                { "type": "integer",    "description": "Maximum targets to cycle through" },
      "line_cd":                          { "type": "timespan",   "description": "Per-line cooldown (e.g., line_cd=15)" },
      "action_skill":                     { "type": "number",     "description": "Override action skill (0-1)" }
    },
    "target_if_modes": {
      "description": "target_if can be prefixed with a mode: target_if=min:expr, target_if=max:expr, target_if=first:expr",
      "modes": ["min", "max", "first"]
    }
  },

  "apl_syntax": {
    "description": "General APL file syntax rules",
    "action_list_format": "actions[.list_name]+=/action_name[,option=value]*",
    "comment_format": "# comment or actions+=/# comment",
    "examples": [
      "actions=auto_attack",
      "actions+=/call_action_list,name=cooldowns,if=fight_remains>20",
      "actions+=/fireball,if=buff.hot_streak.down&!prev_gcd.1.fireball",
      "actions+=/variable,name=burn_phase,op=set,value=1,if=buff.arcane_power.up",
      "actions+=/moonfire,target_if=refreshable",
      "actions+=/use_item,slot=trinket1,if=cooldown.combustion.remains<5",
      "actions.cooldowns=berserking,if=buff.power_infusion.up",
      "actions.cooldowns+=/blood_fury"
    ]
  }
