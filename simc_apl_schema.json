        "cost":                 { "type": "number",  "description": "Resource cost of the action" },
        "cost_affordable":      { "type": "boolean", "description": "Whether the cost is currently affordable" },
        "target":               { "type": "number",  "description": "Current target actor index" },
        "gcd":                  { "type": "number",  "description": "GCD triggered by this action" },
        "cooldown":             { "type": "number",  "description": "Cooldown duration of the action" },
        "travel_time":          { "type": "number",  "description": "Projectile travel time" },
        "available_targets":    { "type": "number",  "description": "Number of available targets" },
        "tick_time":            { "type": "number",  "description": "Tick time of the active DoT" },
