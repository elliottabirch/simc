        "bugs":                 { "type": "boolean", "description": "Whether bugs simulation is enabled" },
        "is_add":               { "type": "boolean", "description": "Whether this actor is an add" },
        "is_boss":              { "type": "boolean", "description": "Whether this actor is a boss" },
        "is_enemy":             { "type": "boolean", "description": "Whether this actor is an enemy" },
        "attack_haste":         { "type": "number", "description": "Current attack haste multiplier" },
        "auto_attack_speed":    { "type": "number", "description": "Current auto attack speed multiplier" },
        "spell_haste":          { "type": "number", "description": "Current spell haste multiplier" },
        "spell_cast_speed":     { "type": "number", "description": "Current spell cast speed multiplier" },
        "mastery_value":        { "type": "number", "description": "Current mastery value" },
        "attack_crit":          { "type": "number", "description": "Current attack crit chance" },
        "spell_crit":           { "type": "number", "description": "Current spell crit chance" },
        "parry_chance":         { "type": "number", "description": "Current parry chance" },
        "dodge_chance":         { "type": "number", "description": "Current dodge chance" },
        "block_chance":         { "type": "number", "description": "Current block chance" },
        "position_front":       { "type": "boolean", "description": "Whether at front of target" },
        "position_back":        { "type": "boolean", "description": "Whether at back of target" },
        "time_to_bloodlust":    { "type": "number", "description": "Time until bloodlust in seconds" },
        "raw_haste_pct":        { "type": "number", "description": "Raw initial haste percentage from rating" }
      },
      "dynamic_keywords": {
        "time_to_die":                    { "type": "number", "description": "Estimated time until target dies" },
        "time_to_pct_<value>":            { "type": "number", "description": "Estimated time until target reaches <value> percent health" },
        "incoming_damage_<duration>":     { "type": "number", "description": "Total incoming damage in last <duration> seconds (or <duration>ms for milliseconds)" },
        "incoming_magic_damage_<duration>": { "type": "number", "description": "Total incoming magic damage in last <duration> seconds" }
      }
    },

    "buff": {
      "_source": "engine/buff/buff.cpp:334",
      "syntax": "buff.<name>.<suffix>",
      "also_applies_to": "debuff.<name>.<suffix>",
      "property_normalization": {
        "description": "In JSON AST output, aliased buff/debuff properties are normalized to canonical forms. When normalization occurs, the original property is preserved in the 'original_property' field.",
        "mappings": {
          "up":            { "canonical": "stack", "reason": "check() > 0 — boolean of stack count" },
          "down":          { "canonical": "stack", "reason": "check() <= 0 — negated boolean of stack count" },
          "stack":         { "canonical": "stack", "reason": "Identity (already canonical)" },
          "stack_pct":     { "canonical": "stack", "reason": "100 * check() / max_stack() — derived from stack" },
          "at_max_stacks": { "canonical": "stack", "reason": "check() == max_stack() — derived from stack" },
          "react":         { "canonical": "react", "reason": "Identity (already canonical)" },
          "react_pct":     { "canonical": "react", "reason": "100 * stack_react() / max_stack() — derived from react" }
        },
        "example": {
          "input":  "buff.X.down",
          "output": { "property": "stack", "original_property": "down", "spell_id": 365362 }
        }
      },
      "suffixes": {
        "up":                           { "type": "boolean", "description": "Buff is active (stack > 0)", "canonical_property": "stack" },
        "down":                         { "type": "boolean", "description": "Buff is not active (stack <= 0)", "canonical_property": "stack" },
        "stack":                        { "type": "number",  "description": "Current stack count", "canonical_property": "stack" },
        "stack_pct":                    { "type": "number",  "description": "Current stacks as percentage of max stacks", "canonical_property": "stack" },
        "max_stack":                    { "type": "number",  "description": "Maximum possible stacks" },
        "at_max_stacks":                { "type": "boolean", "description": "Whether at maximum stacks", "canonical_property": "stack" },
        "remains":                      { "type": "number",  "description": "Time remaining in seconds" },
        "duration":                     { "type": "number",  "description": "Full buff duration in seconds" },
        "elapsed":                      { "type": "number",  "description": "Time elapsed since application" },
        "tick_time":                    { "type": "number",  "description": "Time between buff ticks" },
        "tick_time_remains":            { "type": "number",  "description": "Time until next buff tick" },
        "cooldown_remains":             { "type": "number",  "description": "Buff internal cooldown remaining" },
        "internal_cooldown_remains":    { "type": "number",  "description": "Buff internal cooldown remaining (from ICD)" },
        "value":                        { "type": "number",  "description": "Current buff value" },
        "default_value":                { "type": "number",  "description": "Default buff value" },
        "stack_value":                  { "type": "number",  "description": "Value per stack times current stacks" },
        "react":                        { "type": "number",  "description": "Reactive stack count (accounts for reaction time)", "canonical_property": "react" },
        "react_pct":                    { "type": "number",  "description": "Reactive stacks as percentage of max", "canonical_property": "react" },
        "cooldown_react":               { "type": "number",  "description": "Cooldown remaining accounting for reaction time" },
        "last_trigger":                 { "type": "number",  "description": "Time since buff was last triggered" },
        "last_expire":                  { "type": "number",  "description": "Time since buff last expired" },
        "expiration_delay_remains":     { "type": "number",  "description": "Remaining expiration delay time" }
      }
    },

    "cooldown": {
      "_source": "engine/sim/cooldown.cpp:520",
      "syntax": "cooldown.<name>.<suffix>",
      "property_normalization": {
        "description": "In JSON AST output, aliased cooldown properties are normalized to canonical forms.",
        "mappings": {
          "ready":            { "canonical": "up", "reason": "Exact alias for up" },
          "remains_guess":    { "canonical": "remains_expected", "reason": "Exact alias for remains_expected" },
          "duration_guess":   { "canonical": "duration_expected", "reason": "Exact alias for duration_expected" }
        }
      },
      "suffixes": {
        "remains":              { "type": "number",  "description": "Time remaining on cooldown" },
        "up":                   { "type": "boolean", "description": "Cooldown is ready", "canonical_property": "up" },
        "ready":                { "type": "boolean", "description": "Cooldown is ready (alias of up)", "canonical_property": "up" },
        "duration":             { "type": "number",  "description": "Current cooldown duration (with recharge multiplier)" },
        "base_duration":        { "type": "number",  "description": "Base cooldown duration" },
        "charges":              { "type": "number",  "description": "Current available charges" },
        "charges_fractional":   { "type": "number",  "description": "Fractional charge count (including partial recharge)" },
        "max_charges":          { "type": "number",  "description": "Maximum charges" },
        "recharge_time":        { "type": "number",  "description": "Time until next charge is ready" },
        "full_recharge_time":   { "type": "number",  "description": "Time until all charges are ready" },
        "remains_expected":     { "type": "number",  "description": "Estimated remaining cooldown accounting for CDR", "canonical_property": "remains_expected" },
        "remains_guess":        { "type": "number",  "description": "Estimated remaining cooldown accounting for CDR (alias of remains_expected)", "canonical_property": "remains_expected" },
        "duration_expected":    { "type": "number",  "description": "Estimated total cooldown duration accounting for CDR", "canonical_property": "duration_expected" },
        "duration_guess":       { "type": "number",  "description": "Estimated total cooldown duration accounting for CDR (alias of duration_expected)", "canonical_property": "duration_expected" }
      }
    },

    "dot": {
      "_source": "engine/action/dot.cpp:408",
      "syntax": "dot.<name>.<suffix>",
      "suffixes": {
        "ticking":                  { "type": "boolean", "description": "Whether the DoT is active" },
        "remains":                  { "type": "number",  "description": "Time remaining on DoT" },
        "ticks":                    { "type": "number",  "description": "Current tick count since application" },
        "current_ticks":            { "type": "number",  "description": "Total number of ticks for current application" },
        "ticks_remain":             { "type": "number",  "description": "Whole ticks remaining" },
        "ticks_remain_fractional":  { "type": "number",  "description": "Fractional ticks remaining" },
        "duration":                 { "type": "number",  "description": "Full DoT duration" },
        "tick_time_remains":        { "type": "number",  "description": "Time until next tick" },
        "tick_dmg":                 { "type": "number",  "description": "Estimated hit tick damage" },
        "crit_dmg":                 { "type": "number",  "description": "Estimated crit tick damage" },
        "crit_pct":                 { "type": "number",  "description": "Crit chance of DoT snapshot" },
        "extended_time":            { "type": "number",  "description": "Extra time added via extensions" },
        "refreshable":              { "type": "boolean", "description": "Whether the DoT is refreshable (pandemic window)" },
        "spell_power":              { "type": "number",  "description": "Spell power snapshot on the DoT" },
        "attack_power":             { "type": "number",  "description": "Attack power snapshot on the DoT" },
        "multiplier":               { "type": "number",  "description": "Target ability multiplier snapshot" },
        "pmultiplier":              { "type": "number",  "description": "Persistent multiplier snapshot" },
        "haste_pct":                { "type": "number",  "description": "Haste percentage of snapshot" },
        "haste_pct_next_tick":      { "type": "number",  "description": "Haste percentage at next tick evaluation" },
        "stack":                    { "type": "number",  "description": "Current DoT stack count" },
