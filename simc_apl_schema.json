        "tick_multiplier":      { "type": "number",  "description": "Composite tick ability multiplier" },
        "crit_pct_current":     { "type": "number",  "description": "Current crit percentage (0-100)" },
        "energize_amount":      { "type": "number",  "description": "Resource generated by this action" },
        "persistent_multiplier": { "type": "number", "description": "Persistent multiplier for snapshotting" },
        "damage":               { "type": "number",  "description": "Estimated direct damage (average of hit/crit)" },
        "hit_damage":           { "type": "number",  "description": "Estimated direct hit damage" },
        "crit_damage":          { "type": "number",  "description": "Estimated direct crit damage" },
        "hit_heal":             { "type": "number",  "description": "Estimated direct hit heal" },
        "crit_heal":            { "type": "number",  "description": "Estimated direct crit heal" },
        "tick_damage":          { "type": "number",  "description": "Estimated tick damage (average of hit/crit)" },
        "hit_tick_damage":      { "type": "number",  "description": "Estimated hit tick damage" },
        "crit_tick_damage":     { "type": "number",  "description": "Estimated crit tick damage" },
        "tick_heal":            { "type": "number",  "description": "Estimated hit tick heal" },
        "crit_tick_heal":       { "type": "number",  "description": "Estimated crit tick heal" },
        "multiplier":           { "type": "number",  "description": "Highest school multiplier for the action" },
