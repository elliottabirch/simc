    "resource": {
      "_source": "engine/player/player.cpp:12734",
      "syntax": ["<resource>", "<resource>.<suffix>"],
      "resource_types": [
        "health", "mana", "rage", "energy", "focus",
        "runic_power", "rune", "soul_shard", "astral_power",
        "holy_power", "chi", "combo_points", "maelstrom",
        "fury", "insanity", "essence"
      ],
      "property_normalization": {
        "description": "In JSON AST output, resource expressions are two-part (e.g. mana.pct). The 'percent' suffix is normalized to 'pct' in the name field, with the original preserved in 'original_name'.",
        "mappings": {
          "percent": { "canonical": "pct", "reason": "Exact alias for pct" }
        }
      },
      "suffixes": {
        "<bare>":       { "type": "number", "description": "Current resource amount (no suffix needed)" },
        "deficit":      { "type": "number", "description": "max - current" },
        "pct":          { "type": "number", "description": "Current as percentage of max (0-100)", "canonical_name": "pct" },
        "percent":      { "type": "number", "description": "Alias for pct", "canonical_name": "pct" },
        "max":          { "type": "number", "description": "Maximum resource amount" },
        "max_nonproc":  { "type": "number", "description": "Buffed max resource (snapshot)" },
        "pct_nonproc":  { "type": "number", "description": "Current as percentage of buffed max" },
        "net_regen":    { "type": "number", "description": "Net resource regeneration per second" },
        "regen":        { "type": "number", "description": "Resource regeneration rate per second" },
        "time_to_max":  { "type": "number", "description": "Estimated seconds until resource is full" },
        "time_to_<N>":  { "type": "number", "description": "Estimated seconds until resource reaches <N>" }
      }
